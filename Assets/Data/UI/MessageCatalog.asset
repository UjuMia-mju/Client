--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 054adfe439ae4256b51c304ac978c7cd, type: 3}
  m_Name: MessageCatalog
  m_EditorClassIdentifier: Assembly-CSharp::MessageCatalog
  entries:
  - key: login.empty_credentials
    text: "\uC544\uC774\uB514\uC640 \uBE44\uBC00\uBC88\uD638\uB97C \uC785\uB825\uD574
      \uC8FC\uC138\uC694."
  - key: login.invalid_credentials
    text: "\uC544\uC774\uB514 \uB610\uB294 \uBE44\uBC00\uBC88\uD638\uAC00 \uC62C\uBC14\uB974\uC9C0
      \uC54A\uC2B5\uB2C8\uB2E4."
  - key: login.network_failure
    text: "\uC11C\uBC84\uC640\uC758 \uC5F0\uACB0\uC744 \uC2E4\uD328\uD588\uC2B5\uB2C8\uB2E4."
  - key: network.server_disconnected
    text: "\uC11C\uBC84\uC640\uC758 \uC5F0\uACB0\uC774 \uB04A\uC5B4\uC84C\uC2B5\uB2C8\uB2E4."
  - key: network.connect_failed
    text: "\uC11C\uBC84\uC5D0 \uC5F0\uACB0\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.
      \uB124\uD2B8\uC6CC\uD06C\uC640 \uC8FC\uC18C\uB97C \uD655\uC778\uD574 \uC8FC\uC138\uC694."
  - key: network.not_connected
    text: "\uC11C\uBC84\uC5D0 \uC5F0\uACB0\uB418\uC5B4 \uC788\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
  - key: network.login_in_progress
    text: "\uB85C\uADF8\uC778 \uC694\uCCAD \uCC98\uB9AC \uC911\uC785\uB2C8\uB2E4."
  - key: network.enter_game_failed
    text: "\uAC8C\uC784 \uC785\uC7A5\uC5D0 \uC2E4\uD328\uD588\uC2B5\uB2C8\uB2E4."
  - key: network.protocol_unreadable
    text: "\uC11C\uBC84 \uC751\uB2F5\uC744 \uCC98\uB9AC\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
  - key: lobby.invite_failed
    text: "\uCD08\uB300\uB97C \uBCF4\uB0BC \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
  - key: lobby.invite_failed_with_reason
    text: "\uCD08\uB300 \uC804\uC1A1 \uC2E4\uD328: {0}"
  - key: lobby.invite_response_failed
    text: "\uCD08\uB300\uC5D0 \uC751\uB2F5\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
  - key: lobby.invite_response_failed_with_reason
    text: "\uCD08\uB300 \uC751\uB2F5 \uC2E4\uD328: {0}"
  - key: lobby.invite_target_name_required
    text: "\uCD08\uB300\uD560 \uC720\uC800 \uC774\uB984\uC744 \uC785\uB825\uD574
      \uC8FC\uC138\uC694."
  - key: lobby.invite_target_tag_invalid
    text: "\uD0DC\uADF8\uB97C \uC798\uBABB \uC785\uB825\uD588\uC2B5\uB2C8\uB2E4."
  - key: lobby.invite_self_not_allowed
    text: "\uC790\uAE30 \uC790\uC2E0\uC5D0\uAC8C\uB294 \uCD08\uB300\uB97C \uBCF4\uB0BC
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
  - key: lobby.invite_notification
    text: "{0}\uB2D8\uC774 \uCD08\uB300\uB97C \uBCF4\uB0C8\uC2B5\uB2C8\uB2E4."
  - key: lobby.multiplay_login_required
    text: "\uB85C\uADF8\uC778 \uD6C4 \uBA40\uD2F0\uD50C\uB808\uC774\uB97C \uC774\uC6A9\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - key: lobby.create_room_failed_leave_previous
    text: "\uC774\uC804 \uBC29 \uD1F4\uC7A5\uC5D0 \uC2E4\uD328\uD588\uC2B5\uB2C8\uB2E4."
  - key: lobby.create_room_failed
    text: "\uBC29 \uC0DD\uC131\uC5D0 \uC2E4\uD328\uD588\uC2B5\uB2C8\uB2E4."
  - key: lobby.create_room_failed_with_reason
    text: "\uBC29 \uC0DD\uC131\uC5D0 \uC2E4\uD328\uD588\uC2B5\uB2C8\uB2E4. {0}"
  - key: lobby.enter_room_failed
    text: "\uBC29 \uC785\uC7A5\uC5D0 \uC2E4\uD328\uD588\uC2B5\uB2C8\uB2E4."
  - key: lobby.enter_room_failed_with_reason
    text: "\uBC29 \uC785\uC7A5\uC5D0 \uC2E4\uD328\uD588\uC2B5\uB2C8\uB2E4. {0}"
  - key: lobby.start_room_failed
    text: "\uAC8C\uC784\uC744 \uC2DC\uC791\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
  - key: lobby.start_room_failed_with_reason
    text: "\uAC8C\uC784 \uC2DC\uC791 \uC2E4\uD328: {0}"
  - key: lobby.leave_room_failed
    text: "\uBC29\uC744 \uB098\uAC08 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
  - key: stage.start_rejected
    text: "\uC2A4\uD14C\uC774\uC9C0\uB97C \uC2DC\uC791\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
  - key: stage.clear_info_failed
    text: "\uD074\uB9AC\uC5B4 \uC815\uBCF4\uB97C \uBD88\uB7EC\uC624\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4."
  - key: stage.game_clear_failed
    text: "\uD074\uB9AC\uC5B4 \uAE30\uB85D\uC744 \uC800\uC7A5\uD558\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4."
  - key: gacha.request_pending
    text: "\uC774\uBBF8 \uAC00\uCC60 \uC694\uCCAD\uC744 \uBCF4\uB0C8\uC2B5\uB2C8\uB2E4."
  - key: gacha.spin_in_progress
    text: "\uC2A4\uD540 \uC5F0\uCD9C\uC774 \uC9C4\uD589 \uC911\uC785\uB2C8\uB2E4."
  - key: gacha.invalid_pool
    text: "\uC720\uD6A8\uD55C \uAC00\uCC60 \uD480\uC774 \uC5C6\uC2B5\uB2C8\uB2E4. "
  - key: gacha.failed
    text: "\uAC00\uCC60\uC5D0 \uC2E4\uD328\uD588\uC2B5\uB2C8\uB2E4."
  - key: gacha.failed_with_reason
    text: "\uAC00\uCC60 \uC2E4\uD328: {0}"
  - key: gacha.no_result
    text: "\uAC00\uCC60 \uACB0\uACFC\uC5D0 \uD68D\uB4DD\uD55C \uC2A4\uD0A8\uC774
      \uC5C6\uC2B5\uB2C8\uB2E4."
  - key: gacha.spin_start_failed
    text: "\uD604\uC7AC\uB294 \uAC00\uCC60\uB97C \uC2E4\uD589\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
  - key: craft.furnace_busy_or_has_result
    text: "\uC6A9\uAD11\uB85C\uC5D0 \uC81C\uB828 \uC644\uB8CC\uB41C \uAD11\uBB3C\uC774
      \uC788\uC2B5\uB2C8\uB2E4."
  - key: craft.furnace_still_working
    text: "\uC6A9\uAD11\uB85C\uAC00 \uC544\uC9C1 \uC791\uB3D9 \uC911\uC785\uB2C8\uB2E4."
  - key: craft.furnace_cannot_smelt
    text: "\uC81C\uB828\uD560 \uC218 \uC5C6\uB294 \uC544\uC774\uD15C\uC785\uB2C8\uB2E4."
  - key: craft.furnace_still_processing
    text: "\uC6A9\uAD11\uB85C\uAC00 \uC774\uC804 \uC791\uC5C5\uC744 \uCC98\uB9AC
      \uC911\uC785\uB2C8\uB2E4."
  - key: craft.spaceship_not_item
    text: "\uC544\uC774\uD15C\uB9CC \uC6B0\uC8FC\uC120\uC5D0 \uB123\uC744 \uC218
      \uC788\uC2B5\uB2C8\uB2E4."
  - key: craft.spaceship_no_item_component
    text: "\uC544\uC774\uD15C \uC815\uBCF4\uB97C \uD655\uC778\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
  - key: craft.spaceship_wrong_item
    text: "\uC774 \uC6B0\uC8FC\uC120\uC5D0 \uD544\uC694\uD558\uC9C0 \uC54A\uC740
      \uC544\uC774\uD15C\uC785\uB2C8\uB2E4."
  - key: craft.craft_table_empty
    text: "\uC870\uD569\uB300\uC5D0 \uC544\uC774\uD15C\uC774 \uC5C6\uC2B5\uB2C8\uB2E4."
  - key: craft.craft_prefab_not_found
    text: "\uC870\uD569 \uACB0\uACFC\uBB3C\uC744 \uCC3E\uC744 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
  - key: craft.furnace_already_smelted_item
    text: "\uC774\uBBF8 \uC81C\uB828\uB41C \uC544\uC774\uD15C\uC740 \uB123\uC744
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
  - key: craft.furnace_legacy_busy
    text: "\uC6A9\uAD11\uB85C\uAC00 \uC791\uB3D9 \uC911\uC785\uB2C8\uB2E4."
  - key: craft.furnace_legacy_not_item
    text: "\uC544\uC774\uD15C\uB9CC \uC6A9\uAD11\uB85C\uC5D0 \uB123\uC744 \uC218
      \uC788\uC2B5\uB2C8\uB2E4."
  - key: craft.furnace_legacy_no_recipe
    text: "\uC81C\uB828\uD560 \uC218 \uC5C6\uB294 \uC544\uC774\uD15C\uC785\uB2C8\uB2E4."
  - key: keybinding.conflict_choice
    text: '{0} ({1})'
  - key: main.custom_coming_soon
    text: "\uC5C5\uB370\uC774\uD2B8 \uC608\uC815\uC785\uB2C8\uB2E4."
