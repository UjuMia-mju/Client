    \uAD70\uB77D\uC774 \uC9C0\uD45C\uBA74\uC744 \uC644\uC804\uD788 \uC810\uB839\uD55C
    \uD589\uC131\uC785\uB2C8\uB2E4. \n\n\uC774\uACF3\uC758 \uC2DD\uBB3C\uB4E4\uC740
    \uBE44\uC815\uC0C1\uC801\uC73C\uB85C \uAC70\uB300\uD558\uC5EC, \n\uD55C \uADF8\uB8E8\uC758
    \uB192\uC774\uAC00 \uC218 \uD0AC\uB85C\uBBF8\uD130\uC5D0 \uB2EC\uD569\uB2C8\uB2E4.
    \n\n\uB300\uAE30 \uC911\uC5D0\uB294 \uACE0\uB18D\uB3C4\uC758 \uC0B0\uC18C\uC640
    \uD3EC\uC790\uAC00 \uAC00\uB4DD \uCC28 \uC788\uC5B4, \uBAA8\uB4E0 \uC720\uAE30\uBB3C\uC740
    \uC77C\uBC18\uC801\uC778 \uD658\uACBD\uBCF4\uB2E4 \uC218\uC2ED \uBC30 \uBE60\uB978
    \uC18D\uB3C4\uB85C \uC131\uC7A5\uD569\uB2C8\uB2E4."
